{
    "$schema": "https://playground.wordpress.net/blueprint-schema.json",
    "landingPage": "/wp-admin/options-general.php?page=svg-support",
    "preferredVersions": {
        "php": "8.3",
        "wp": "latest"
    },
    "phpExtensionBundles": [
        "kitchen-sink"
    ],
    "steps": [
        {
            "step": "login",
            "username": "admin",
            "password": "password"
        },
        {
            "step": "installPlugin",
            "pluginData": {
                "resource": "git:directory",
                "url": "https://github.com/benbodhi/svg-support",
                "ref": "master",
                "refType": "branch",
                "path": "/"
            },
            "options": {
                "activate": true
            }
        }
    ]
}
