{
    "name": "benbodhi/svg-support",
    "description": "Upload SVG files to the Media Library and render SVG files inline for direct styling/animation of an SVG's internal elements using CSS/JS.",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "repositories": [
        {
            "type": "package",
            "package": {
                "name": "cure53/dompurify",
                "version": "3.4.12",
                "dist": {
                    "url": "https://github.com/cure53/DOMPurify/archive/refs/tags/3.4.12.zip",
                    "type": "zip"
                }
            }
        }
    ],
    "require": {
        "php": ">=7.4",
        "cure53/dompurify": "3.4.12",
        "enshrined/svg-sanitize": "^0.22.0"
    },
    "scripts": {
        "post-install-cmd": [
            "mkdir -p vendor/DOMPurify",
            "grep -v 'sourceMappingURL=purify.min.js.map' vendor/cure53/dompurify/dist/purify.min.js > vendor/DOMPurify/DOMPurify.min.js"
        ],
        "post-update-cmd": [
            "mkdir -p vendor/DOMPurify",
            "grep -v 'sourceMappingURL=purify.min.js.map' vendor/cure53/dompurify/dist/purify.min.js > vendor/DOMPurify/DOMPurify.min.js"
        ],
        "check": "bin/plugin-check.sh",
        "check:errors": "bin/plugin-check.sh --ignore-warnings"
    },
    "scripts-descriptions": {
        "check": "Run the WordPress.org Plugin Check against this plugin in your LocalWP site.",
        "check:errors": "Same as check, but report blocking errors only (skip warnings)."
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    }
}